# TrustLens Environment Configuration Example
# Copy this file to .env and configure the keys

PORT=5000
NODE_ENV=production

# -------------------------------------------------------------
# Optional Real-World Integration Adapters
# In demo mode, TrustLens operates using internal heuristic models
# and dataset benchmarks. Populate these keys to enable live services.
# -------------------------------------------------------------

# 1. Google Safe Browsing API v4 (for live web reputation checks)
# Get key: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# 2. VirusTotal API v3 (for multi-engine domain & URL scanning)
# Get key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# 3. Google Play Integrity / Developer API (for app signature & publisher checks)
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

# 4. NPCI / Bank UPI VPA Validation Gateway (for live payee name verification)
NPCI_UPI_API_SECRET=

# 5. Truecaller / Telecom Scam Reputation API (for live caller identity checks)
CALLER_INTEL_API_KEY=

# 6. Deepfake Audio Neural Analyzer API (for live synthetic voice classification)
DEEPFAKE_DETECTOR_API_KEY=
